  },
  "size": {
    "tapTarget": { "$type": "dimension", "$value": "44px" }, "button": { "$type": "dimension", "$value": "52px" }, "buttonCompact": { "$type": "dimension", "$value": "44px" }, "field": { "$type": "dimension", "$value": "52px" }, "nav": { "$type": "dimension", "$value": "80px" }, "icon": { "$type": "dimension", "$value": "24px" }
  },
