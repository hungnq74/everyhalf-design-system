    "card": { "$type": "shadow", "$value": { "color": "#231F2010", "offsetX": "0px", "offsetY": "6px", "blur": "20px", "spread": "0px" } },
    "float": { "$type": "shadow", "$value": { "color": "#231F2024", "offsetX": "0px", "offsetY": "10px", "blur": "28px", "spread": "0px" } }
